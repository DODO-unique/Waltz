// use prisma-8
// Contract inferred from the live database schema. Edit as needed, then run `prisma contract emit`.

model Clients {
  id           Uuid              @id(map: "clients_pkey") @default(sql`gen_random_uuid()`)
  name         VarChar(400)
  email        String            @unique(map: "clients_email_key")
  registeredAt TimestamptzString @default(now()) @map("registered_at")
  contracts    Contracts[]
  security     Security?

  @@map("clients")
}

model Contracts {
  id       Uuid    @id(map: "contracts_pkey")
  clientId Uuid    @map("client_id")
  contract Jsonb
  client   Clients @relation(fields: [clientId], references: [id], map: "contracts_client_id_fkey", index: false)

  @@map("contracts")
}

model Security {
  id           Uuid    @id(map: "security_pkey") @default(sql`gen_random_uuid()`)
  userId       Uuid    @unique(map: "security_user_id_key") @map("user_id")
  clientSecret String  @map("client_secret")
  passwordHash String  @map("password_hash")
  user         Clients @relation(fields: [userId], references: [id], map: "security_user_id_fkey")

  @@map("security")
}
